datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// Core & Multi-Tenancy / Auth
// ----------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  roles          Role[]
  auditLogs      AuditLog[]
  categories     Category[]
  products       Product[]
  warehouses     Warehouse[]
  stockLevels    StockLevel[]
  stockTransfers StockTransfer[]
  vendors        Vendor[]
  purchaseOrders PurchaseOrder[]
  goodsReceived  GoodsReceivedNote[]
  customers      Customer[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]
  invoices       Invoice[]
  payments       Payment[]
  accounts       Account[]
  journalEntries JournalEntry[]
  expenses       Expense[]
  employees      Employee[]
  attendances    Attendance[]
  payrollRuns    PayrollRun[]
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]
  tokens    RefreshToken[]
  auditLogs AuditLog[]

  @@unique([tenantId, email])
}

model Role {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  description String?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([tenantId, name])
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ----------------------------------------------------
// Inventory Management
// ----------------------------------------------------

model Category {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  code        String
  description String?
  createdAt   DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, code])
}

model Product {
  id            String   @id @default(uuid())
  tenantId      String
  categoryId    String
  sku           String
  name          String
  description   String?
  unitOfMeasure String   @default("units")
  costPrice     Float    @default(0.0)
  sellingPrice  Float    @default(0.0)
  minStockLevel Int      @default(10)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        Category            @relation(fields: [categoryId], references: [id])
  stockLevels     StockLevel[]
  transferItems   StockTransferItem[]
  poItems         PurchaseOrderItem[]
  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]
  invoiceItems    InvoiceItem[]

  @@unique([tenantId, sku])
}

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String
  code      String
  name      String
  location  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockLevels     StockLevel[]
  sourceTransfers StockTransfer[]     @relation("SourceWarehouse")
  targetTransfers StockTransfer[]     @relation("TargetWarehouse")
  goodsReceived   GoodsReceivedNote[]
  salesOrders     SalesOrder[]

  @@unique([tenantId, code])
}

model StockLevel {
  id                String   @id @default(uuid())
  tenantId          String
  productId         String
  warehouseId       String
  quantityOnHand    Int      @default(0)
  quantityReserved  Int      @default(0)
  quantityAvailable Int      @default(0)
  updatedAt         DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
}

model StockTransfer {
  id                String   @id @default(uuid())
  tenantId          String
  transferNumber    String
  sourceWarehouseId String
  targetWarehouseId String
  status            String   @default("PENDING")
  requestedBy       String
  approvedBy        String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceWarehouse Warehouse           @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  targetWarehouse Warehouse           @relation("TargetWarehouse", fields: [targetWarehouseId], references: [id])
  items           StockTransferItem[]

  @@unique([tenantId, transferNumber])
}

model StockTransferItem {
  id         String @id @default(uuid())
  transferId String
  productId  String
  quantity   Int

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])
}

// ----------------------------------------------------
// Procurement
// ----------------------------------------------------

model Vendor {
  id           String   @id @default(uuid())
  tenantId     String
  code         String
  companyName  String
  contactName  String?
  email        String
  phone        String?
  address      String?
  paymentTerms String   @default("NET30")
  createdAt    DateTime @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  tenantId     String
  poNumber     String
  vendorId     String
  status       String    @default("DRAFT")
  subtotal     Float     @default(0.0)
  taxAmount    Float     @default(0.0)
  totalAmount  Float     @default(0.0)
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor        Vendor              @relation(fields: [vendorId], references: [id])
  items         PurchaseOrderItem[]
  goodsReceived GoodsReceivedNote[]

  @@unique([tenantId, poNumber])
}

model PurchaseOrderItem {
  id               String @id @default(uuid())
  purchaseOrderId  String
  productId        String
  unitPrice        Float
  quantityOrdered  Int
  quantityReceived Int    @default(0)
  totalPrice       Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  grnItems      GRNItem[]
}

model GoodsReceivedNote {
  id              String   @id @default(uuid())
  tenantId        String
  grnNumber       String
  purchaseOrderId String
  warehouseId     String
  receivedById    String
  receivedDate    DateTime @default(now())
  notes           String?

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  items         GRNItem[]

  @@unique([tenantId, grnNumber])
}

model GRNItem {
  id                  String @id @default(uuid())
  grnId               String
  purchaseOrderItemId String
  quantityReceived    Int

  grn               GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
}

// ----------------------------------------------------
// Sales Order Management
// ----------------------------------------------------

model Customer {
  id              String   @id @default(uuid())
  tenantId        String
  code            String
  name            String
  email           String
  phone           String?
  billingAddress  String?
  shippingAddress String?
  creditLimit     Float    @default(10000.0)
  createdAt       DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotations  Quotation[]
  salesOrders SalesOrder[]
  invoices    Invoice[]

  @@unique([tenantId, code])
}

model Quotation {
  id          String   @id @default(uuid())
  tenantId    String
  quoteNumber String
  customerId  String
  status      String   @default("DRAFT")
  validUntil  DateTime
  totalAmount Float    @default(0.0)
  createdAt   DateTime @default(now())

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer        @relation(fields: [customerId], references: [id])
  items      QuotationItem[]
  salesOrder SalesOrder?

  @@unique([tenantId, quoteNumber])
}

model QuotationItem {
  id          String @id @default(uuid())
  quotationId String
  productId   String
  quantity    Int
  unitPrice   Float
  discount    Float  @default(0.0)
  totalPrice  Float

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
}

model SalesOrder {
  id          String   @id @default(uuid())
  tenantId    String
  soNumber    String
  quotationId String?  @unique
  customerId  String
  warehouseId String
  status      String   @default("PENDING")
  totalAmount Float    @default(0.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotation Quotation?       @relation(fields: [quotationId], references: [id])
  customer  Customer         @relation(fields: [customerId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  items     SalesOrderItem[]
  invoices  Invoice[]

  @@unique([tenantId, soNumber])
}

model SalesOrderItem {
  id           String @id @default(uuid())
  salesOrderId String
  productId    String
  quantity     Int
  unitPrice    Float
  discount     Float  @default(0.0)
  totalPrice   Float

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])
}

model Invoice {
  id             String   @id @default(uuid())
  tenantId       String
  invoiceNumber  String
  salesOrderId   String
  customerId     String
  status         String   @default("UNPAID")
  subtotal       Float
  taxRate        Float    @default(10.0)
  taxAmount      Float
  discountAmount Float    @default(0.0)
  totalAmount    Float
  dueDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder    @relation(fields: [salesOrderId], references: [id])
  customer   Customer      @relation(fields: [customerId], references: [id])
  items      InvoiceItem[]
  payments   Payment[]

  @@unique([tenantId, invoiceNumber])
}

model InvoiceItem {
  id         String @id @default(uuid())
  invoiceId  String
  productId  String
  quantity   Int
  unitPrice  Float
  totalPrice Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Payment {
  id            String   @id @default(uuid())
  tenantId      String
  invoiceId     String
  paymentNumber String
  amount        Float
  paymentMethod String   @default("BANK_TRANSFER")
  paymentDate   DateTime @default(now())
  reference     String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([tenantId, paymentNumber])
}

// ----------------------------------------------------
// Finance & Accounting
// ----------------------------------------------------

model Account {
  id          String   @id @default(uuid())
  tenantId    String
  accountCode String
  accountName String
  accountType String
  balance     Float    @default(0.0)
  createdAt   DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]

  @@unique([tenantId, accountCode])
}

model JournalEntry {
  id            String   @id @default(uuid())
  tenantId      String
  entryNumber   String
  entryDate     DateTime @default(now())
  description   String
  referenceType String?
  referenceId   String?
  status        String   @default("DRAFT")
  createdAt     DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  JournalLine[]

  @@unique([tenantId, entryNumber])
}

model JournalLine {
  id             String @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Float  @default(0.0)
  credit         Float  @default(0.0)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])
}

model Expense {
  id            String   @id @default(uuid())
  tenantId      String
  expenseNumber String
  category      String
  amount        Float
  taxAmount     Float    @default(0.0)
  expenseDate   DateTime @default(now())
  description   String?
  paymentStatus String   @default("PAID")
  receiptUrl    String?
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, expenseNumber])
}

// ----------------------------------------------------
// HR & Payroll
// ----------------------------------------------------

model Employee {
  id                String   @id @default(uuid())
  tenantId          String
  employeeCode      String
  firstName         String
  lastName          String
  email             String
  phone             String?
  department        String
  designation       String
  joiningDate       DateTime
  baseSalary        Float
  bankAccountNumber String?
  createdAt         DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  payslips    Payslip[]

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, email])
}

model Attendance {
  id         String   @id @default(uuid())
  tenantId   String
  employeeId String
  date       DateTime
  status     String   @default("PRESENT")
  checkIn    String?
  checkOut   String?

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, date])
}

model PayrollRun {
  id              String   @id @default(uuid())
  tenantId        String
  payrollPeriod   String
  payDate         DateTime
  status          String   @default("DRAFT")
  totalGross      Float    @default(0.0)
  totalDeductions Float    @default(0.0)
  totalNet        Float    @default(0.0)
  createdAt       DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@unique([tenantId, payrollPeriod])
}

model Payslip {
  id           String @id @default(uuid())
  payrollRunId String
  employeeId   String
  basePay      Float
  allowances   Float  @default(0.0)
  deductions   Float  @default(0.0)
  taxAmount    Float  @default(0.0)
  netPay       Float
  status       String @default("DRAFT")

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
}
