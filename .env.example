# Application Environment
NODE_ENV=development
PORT=5000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forge_erp?schema=public"

# JWT Authentication Secrets
JWT_SECRET=super-secret-jwt-access-key-change-in-production-32bytes!
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-change-in-production-32bytes!
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
